{
	// ===== 生产环境 (prod) =====
	// 用法：wrangler deploy -c wrangler.prod.jsonc
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "chanfana-openapi-template-prod",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"vars": {
		"DEEPSEEK_BASE_URL": "https://api.deepseek.com",
		"DEEPSEEK_MODEL": "deepseek-chat"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openapi-template-db-prod",
			"database_id": "4e254628-6511-4199-a996-38cf0f8bec12"
		}
	]
}
